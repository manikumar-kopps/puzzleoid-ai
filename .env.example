# Google OAuth 2.0 Credentials (From Google Cloud Console)
GOOGLE_CLIENT_ID=1048293029102-demo.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret-here

# JWT & Session Security
JWT_SECRET=super-secret-jwt-key-production-change-this-2026
SESSION_SECRET=super-secret-session-key

# Database Configuration
DATABASE_PATH=./database.sqlite
DATABASE_URL=postgresql://user:password@localhost:5432/puzzleoid_db

# Nodemailer / SMTP Email Notification Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-character-gmail-app-password
EMAIL_FROM="Puzzleoid AI Auth System" <auth@puzzleoid.ai>

# Application Base URLs
PORT=5001
APP_URL=http://localhost:5173
NODE_ENV=development
